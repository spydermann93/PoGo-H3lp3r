        limitation, not a real safety issue here), so it's declared project-wide per
        Android's own documented remedy for this check.
    -->
    <issue id="UnsafeOptInUsageError">
        <option name="opt-in" value="androidx.camera.core.ExperimentalGetImage" />
    </issue>
